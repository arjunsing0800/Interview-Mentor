# Supabase Configuration
# Get these from your Supabase project dashboard: Settings > API
# (Only needed for cloud auth + Groq fallback. Local Ollama works without it.)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Local Ollama Configuration (PRIMARY intelligence engine)
# Requires: `ollama serve` + `ollama pull qwen3:1.7b` (or your preferred model)
# Browser CORS preflight to http://localhost:11434 is allowed by default.
VITE_OLLAMA_HOST=http://localhost:11434
VITE_OLLAMA_MODEL=qwen3:1.7b